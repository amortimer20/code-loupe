---
import Layout from '../layouts/Layout.astro';
import { mathExamples } from '../math/examples';
import '../math/math.css';
const example = mathExamples[0], step = example.steps[0];
---
<Layout title="Math demo" description="Explore arithmetic and algebra through teacher-authored worked steps.">
  <header class="math-intro">
    <p class="eyebrow">Mathematics · Experimental</p>
    <h1>One transformation at a time.</h1>
    <p class="lede">Explore three fixed worked examples. Each step highlights what changes and explains why.</p>
  </header>
  <div class="math-example-control">
    <label for="math-example">Worked example</label>
    <select id="math-example" disabled>{mathExamples.map(item => <option value={item.id}>{item.title}</option>)}</select>
    <p id="math-objective">{example.objective}</p>
  </div>
  <section id="math-viewer" class="math-viewer" aria-labelledby="math-title" aria-describedby="math-shortcuts" tabindex="0">
    <header class="math-card-header">
      <h2 id="math-title">{example.title}</h2>
      <button type="button" data-fullscreen aria-label="Fullscreen" title="Fullscreen" aria-pressed="false" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
    </header>
    <div class="math-stage">
      <section class="math-data" aria-label="Variables">
        <h3>Variables</h3>
        <div id="math-variables" class="math-variables"></div>
      </section>
      <div class="math-current-region">
        <div id="math-current" class="math-expression" role="img" aria-label={step.spoken} data-equation="false">
          <span class="math-side" aria-hidden="true">{step.left.map(part => <span class="math-part" data-part={part.id}>{part.text}</span>)}</span>
        </div>
      </div>
    </div>
    <p id="math-caption" class="math-caption"></p>
    <nav class="math-controls" aria-label="Playback">
      <button type="button" data-restart aria-label="Restart" title="Restart (Home)" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM19 5v14l-10-7z"/></svg></button>
      <button type="button" data-back aria-label="Previous step" title="Previous step (←)" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 5.4 14 4l-8 8 8 8 1.4-1.4L8.8 12z"/></svg></button>
      <button type="button" data-play aria-label="Play" title="Play / pause (Space)" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg></button>
      <button type="button" data-next aria-label="Next step" title="Next step (→)" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 5.4 10 4l8 8-8 8-1.4-1.4 6.6-6.6z"/></svg></button>
      <input id="math-scrub" type="range" min="0" max={example.steps.length} value="0" aria-label="Step" disabled />
      <span id="math-counter">Step 0 of {example.steps.length}</span>
      <button type="button" data-motion aria-label="Animations" aria-pressed="true" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM1 8h6v2H1zm1 3h5v2H1zm-1 3h6v2H1z"/></svg></button>
      <select id="math-speed" aria-label="Playback speed" title="Playback speed" disabled>{[.25, .5, .75, 1, 1.5, 2].map(value => <option value={value} selected={value === 1}>{value}×</option>)}</select>
    </nav>
    <p id="math-shortcuts" class="math-shortcuts">Focus this card to use ← / → to step, Home / End to jump, or Space to play / pause.</p>
    <p id="math-announcement" class="math-sr-only" role="status" aria-atomic="true"></p>
  </section>
  <p class="math-prototype-note">These explanations are authored examples. This prototype does not calculate solutions or check student answers.</p>
  <noscript><p>Enable JavaScript to step through the examples. The starting expression is displayed above.</p></noscript>
</Layout>
<script>import '../math/viewer';</script>
