---
import Layout from '../layouts/Layout.astro';
import { buildMathSnapshots, tokens } from '../math-loupe/expression';
import { mathLessons } from '../math-loupe/examples';
import '../math-loupe/math-loupe.css';
// Build-time check: an authoring mistake in any example fails the site build, as code lessons do.
const [first] = mathLessons, start = mathLessons.map(lesson => buildMathSnapshots(lesson))[0][0];
---
<Layout title="Math demo" description="Explore arithmetic and algebra through teacher-authored worked steps.">
  <header class="ml-intro">
    <p class="eyebrow">Mathematics · Experimental</p>
    <h1>One transformation at a time.</h1>
    <p class="lede">Explore three fixed worked examples. Each step highlights what changes and explains why.</p>
  </header>
  <div class="ml-example-control">
    <label for="ml-example">Worked example</label>
    <select id="ml-example" disabled>{mathLessons.map(lesson => <option value={lesson.id}>{lesson.title}</option>)}</select>
    <p id="ml-objective">{first.objective}</p>
  </div>
  <dialog class="lesson-view" id="lesson-view" aria-label="Math lesson" open>
    <math-loupe aria-label={`${first.title}: ${start.spoken}`}>
      <button slot="viewer-actions" class="fullscreen-toggle" type="button" aria-label="Enter fullscreen" aria-pressed="false" title="Enter fullscreen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path class="expand-icon" d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" />
          <path class="collapse-icon" d="M4 9h5V4m11 5h-5V4M9 20v-5H4m11 5v-5h5" />
        </svg>
      </button>
      <p class="ml-fallback">{tokens(start.expression).map(token => token.text).join(' ')}</p>
    </math-loupe>
  </dialog>
  <p class="ml-prototype-note">These explanations are authored examples. This prototype does not calculate solutions or check student answers.</p>
  <noscript><p>Enable JavaScript to step through the examples. The starting expression is shown above.</p></noscript>
</Layout>
<script>import '../math-loupe/viewer'; import '../focus-lesson';</script>
