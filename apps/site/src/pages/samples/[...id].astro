---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getSamples, sitePath, type Sample } from '../../lib/samples';
export async function getStaticPaths() {
  return (await getSamples()).map(sample => ({ params: { id: sample.entry.id }, props: { sample } }));
}
interface Props { sample: Sample }
const { sample } = Astro.props;
const { entry, steps } = sample;
const { Content } = await render(entry);
const source = sitePath(`lessons/${entry.id}.yaml`);
---
<Layout title={entry.data.title} description={entry.data.summary}>
  <a class="back-link" href={sitePath('')}>← Sample library</a>
  <div class="lesson-heading">
    <p class="eyebrow">{entry.data.languageLabel} · {steps} steps · Authored lesson</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <div class="actions">
      <a class="button" href={`${sitePath('playground/')}?sample=${encodeURIComponent(entry.id)}`}>Edit in playground</a>
      <a class="button secondary" href={source} download={`${entry.id.split('/').at(-1)}.yaml`}>Download YAML</a>
    </div>
  </div>
  <dialog class="lesson-view" id="lesson-view" aria-label={entry.data.title} open>
    <code-loupe src={source}>
      <button slot="viewer-actions" class="fullscreen-toggle" type="button" aria-label="Enter fullscreen" aria-pressed="false" title="Enter fullscreen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path class="expand-icon" d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" />
          <path class="collapse-icon" d="M4 9h5V4m11 5h-5V4M9 20v-5H4m11 5v-5h5" />
        </svg>
      </button>
    </code-loupe>
  </dialog>
  <div class="lesson-details">
    <aside class="learning-goal">
      <h2>Learning objective</h2><p>{entry.data.objective}</p>
      <h2>Before this lesson</h2><ul>{entry.data.prerequisites.map(p => <li>{p}</li>)}</ul>
      <div class="tags">{entry.data.topics.map(t => <span>{t}</span>)}</div>
    </aside>
    <div class="prose"><Content /></div>
  </div>
</Layout>
<script>import 'code-loupe'; import '../../focus-lesson';</script>
