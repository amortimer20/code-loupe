{
  "name": "code-loupe-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @code-loupe/site",
    "build": "npm run build:player && npm run build:site",
    "build:player": "npm run build --workspace code-loupe",
    "build:site": "npm run build --workspace @code-loupe/site",
    "build:playground": "npm run build:site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace code-loupe"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
